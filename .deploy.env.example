# Copier en .deploy.env (non commité) et adapter.
# Hôte SSH du VPS
DEPLOY_HOST=utilisateur@serveur.example
# Dossier parent des sites sur le VPS (doit appartenir à l utilisateur SSH) : chaque site va dans $DEPLOY_ROOT/<domaine>/
DEPLOY_ROOT=/home/utilisateur/public_html
# Sites à déployer (fichiers .env.<site>)
DEPLOY_SITES="ecoleprimaire skoolik"
# Domaines (par défaut <site>.app)
DOMAINE_ecoleprimaire=ecoleprimaire.app
DOMAINE_skoolik=skoolik.app
# Options SSH supplémentaires, ex. "-p 2222 -i ~/.ssh/id_vps"
DEPLOY_SSH_OPTS=
