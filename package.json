{
  "name": "ecole-primaire-vue",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:skoolik": "vite --mode skoolik",
    "build": "vite build && node scripts/telechargements.mjs",
    "build:app": "vite build",
    "build:ecoleprimaire": "vite build --mode ecoleprimaire --outDir dist-ecoleprimaire && node scripts/telechargements.mjs --mode ecoleprimaire --outDir dist-ecoleprimaire",
    "build:skoolik": "vite build --mode skoolik --outDir dist-skoolik && node scripts/telechargements.mjs --mode skoolik --outDir dist-skoolik",
    "build:vps": "npm run build:ecoleprimaire && npm run build:skoolik",
    "deploy:vps": "scripts/deploy-vps.sh",
    "telechargements": "node scripts/telechargements.mjs",
    "preview": "vite preview",
    "test": "node tests/lancer.mjs",
    "test:complet": "node tests/lancer.mjs --complet",
    "i18n": "node scripts/i18n.mjs",
    "i18n:relecture": "node scripts/i18n.mjs --relecture",
    "couverture": "node --no-warnings scripts/couverture.mjs"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/playwrite-fr-trad": "^5.3.0",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "playwright-core": "^1.63.0",
    "vite": "^8.1.0"
  }
}
